{
  "name": "biblioteca",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bunx --bun vite build",
    "dev": "bunx --bun vite",
    "duplicates": "bun run duplicates:client && bun run duplicates:server",
    "duplicates:client": "bunx --bun jscpd src",
    "duplicates:server": "bunx --bun jscpd App.py api/ --min-tokens 100 --min-lines 10",
    "everything": "bun run lint && bun run typecheck && bun run fmt && bun run duplicates",
    "fmt": "bunx --bun biome format --write && uvx ruff format && uvx ruff format contracts_gen --config ruff.gen.toml",
    "ignore": "bunx --bun can-i-ignore-scripts",
    "lint": "bunx --bun biome check --write && uvx ruff check && uvx ruff check contracts_gen --config ruff.gen.toml",
    "loc": "bunx --bun cloc src/ App.py api/ --include-ext=ts,tsx,py --by-file",
    "loc:client": "bunx --bun cloc src --include-ext=ts,tsx --by-file",
    "loc:sep": "bun run loc:client && bun run loc:server",
    "loc:server": "bunx --bun cloc App.py api/ --include-ext=py --by-file",
    "typecheck": "bunx --bun tsc --noEmit",
    "typesync": "bunx --package @openapitools/openapi-generator-cli openapi-generator-cli generate -i contracts/biblioteca.yaml -g typescript-axios -o src/api"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource/varela-round": "^5.3.0",
    "@mantine/core": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/modals": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-plugin": "^1.168.47",
    "axios": "^1.20.0",
    "mantine-datatable": "^9.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
